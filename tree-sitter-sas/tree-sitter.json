        "url": "https://github.com/toxicmender/"
      }
    ],
    "links": {
      "repository": "https://github.com/toxicmender/sas2pyspark",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
