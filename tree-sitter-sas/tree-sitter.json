  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sas",
      "camelcase": "SAS",
      "title": "SAS",
      "scope": "source.sas",
      "file-types": [
        "sas"
      ],
      "injection-regex": "^sas$",
      "class-name": "TreeSitterSas"
    }
  ],
  "metadata": {
